[Unit]
Description=Akasha fetch proxy (browser-fingerprint reverse proxy for akasha.cv)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/app/akasha-rust

Environment=PORT=8097
Environment=UPSTREAM_ORIGIN=https://akasha.cv
Environment=IMPERSONATE=chrome
Environment=PYTHONDONTWRITEBYTECODE=1

ExecStart=/usr/bin/python3 /home/ubuntu/app/akasha-rust/scripts/akasha_fetch_proxy.py

Restart=always
RestartSec=5
TimeoutStopSec=10
KillSignal=SIGTERM

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/app/akasha-rust
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes

StandardOutput=journal
StandardError=journal
SyslogIdentifier=akasha-fetch-proxy

[Install]
WantedBy=default.target
