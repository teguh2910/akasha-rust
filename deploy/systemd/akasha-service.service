[Unit]
Description=Akasha HTTP service
Documentation=file:///home/ubuntu/app/akasha-rust/README.md
After=network-online.target akasha-fetch-proxy.service
Wants=network-online.target
Requires=akasha-fetch-proxy.service

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/app/akasha-rust
EnvironmentFile=/home/ubuntu/app/akasha-rust/.env
Environment=RUST_LOG=info,akasha_service=info

ExecStart=/home/ubuntu/.local/bin/akasha-service

Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM
KillMode=mixed

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/app/akasha-rust
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes

StandardOutput=journal
StandardError=journal
SyslogIdentifier=akasha-service

[Install]
WantedBy=default.target
